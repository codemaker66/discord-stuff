{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dopa’s Discord Purifier",
  "mainBinaryName": "DopasPurifierSetup",
  "version": "1.0.0",
  "identifier": "com.dopameanie.purifier.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Dopa's Discord Purifier Setup",
        "width": 960,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": true,
        "backgroundColor": "#0d0b14"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Bardo & Dopa",
    "copyright": "Copyright (c) 2026 Bardo & Dopa",
    "category": "Utility",
    "shortDescription": "Installs Dopa's Discord Purifier into the Discord app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
